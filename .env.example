# ── LLM Provider ─────────────────────────────────────────────────────────────
# The app runs in template mode (no AI responses) without these.
# Set ONE to enable real LLM responses.

# Anthropic Claude (preferred)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI GPT (alternative)
# OPENAI_API_KEY=sk-...

# Force a specific provider — auto-detected if not set
# LLM_PROVIDER=anthropic

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the backend.
# Local dev: http://localhost:3001
# Production: your Railway frontend URL (e.g. https://nyit-frontend-xxx.railway.app)
ALLOWED_ORIGINS=http://localhost:3001

# ── Frontend ──────────────────────────────────────────────────────────────────
# Backend base URL used by Next.js.
# Local dev: http://localhost:8001
# Production: your Railway backend URL (e.g. https://nyit-backend-xxx.railway.app)
NEXT_PUBLIC_API_URL=http://localhost:8001
