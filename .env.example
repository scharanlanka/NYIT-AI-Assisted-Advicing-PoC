# ── LLM Provider ────────────────────────────────────────────────────────────
# The app runs in template mode (no AI responses) without these.
# Set ONE to enable real LLM responses.

# Anthropic Claude (preferred)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI GPT (alternative)
# OPENAI_API_KEY=sk-...

# Force a specific provider — auto-detected if not set
# LLM_PROVIDER=anthropic

# ── Frontend ─────────────────────────────────────────────────────────────────
# Backend URL used by Next.js — defaults to http://localhost:8001
# NEXT_PUBLIC_API_URL=http://localhost:8001
